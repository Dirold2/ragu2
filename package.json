{
  "name": "ragu2",
  "version": "0.2.5",
  "private": true,
  "description": "Discord bot module for RAGU2",
  "repository": {
    "type": "git",
    "url": "https://github.com/dirold2/ragu2.git"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "imports": {
    "#*": "./src/*",
    "#utils": "./utils/*"
  },
  "scripts": {
    "build": "tsc && esbuild 'dist/**/*.js' --outdir=dist --allow-overwrite --minify --sourcemap && d-build",
    "dev": "tsx src/main.ts",
    "start": "node --enable-source-maps --trace-warnings --experimental-specifier-resolution=node dist/main.js",
    "dist": "d-dist",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "pm2:start": "pm2 start ecosystem.config.json",
    "pm2:restart": "pm2 restart ragu2",
    "pm2:stop": "pm2 stop ragu2",
    "pm2:delete": "pm2 delete ragu2",
    "pm2:list": "pm2 list"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@discordx/importer": "^1.3.3",
    "@dotenvx/dotenvx": "^2.35.0",
    "@hyperttp/transport-bun": "^0.3.2",
    "@hyperttp/transport-undici": "^0.4.0",
    "async-retry": "^1.3.3",
    "discord.js": "^14.27.0",
    "discordx": "^11.13.3",
    "dlog2": "^0.1.3",
    "fluent-streamer": "^0.5.5",
    "get-audio-duration": "^4.0.1",
    "hcacher": "^0.3.0",
    "hemmiter": "^0.1.0",
    "hitd2": "^1.2.2",
    "opusscript": "^0.1.1",
    "prom-client": "^15.1.3",
    "typescript": "^7.0.2",
    "yamd2": "^1.5.3"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@types/node": "^26.6.5",
    "dirname-filename-esm": "^1.1.2",
    "esbuild": "latest",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "zod": "^4.6.7"
  }
}
